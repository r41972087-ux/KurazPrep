generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────

// ─── Enums removed for SQLite compatibility ──────────────

// ─── Auth Models ─────────────────────────────────────────────────────

model User {
  id           String         @id @default(uuid())
  email        String         @unique
  passwordHash String         @map("password_hash")
  name         String
  stream       String         @default("NATURAL_SCIENCE")
  gradeLevel   Int            @default(12) @map("grade_level")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  refreshTokens RefreshToken[]
  quizAttempts  QuizAttempt[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique @map("token_hash")
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  familyId  String   @map("family_id")
  isRevoked Boolean  @default(false) @map("is_revoked")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

// ─── Content Models ──────────────────────────────────────────────────

model Subject {
  id          String         @id @default(uuid())
  name        String
  stream      String
  gradeLevel  Int            @map("grade_level")
  iconName    String         @map("icon_name")
  contentHash String?        @map("content_hash") // SHA-256 for delta sync
  units       Unit[]
  createdAt   DateTime       @default(now()) @map("created_at")

  quizAttempts QuizAttempt[]

  @@map("subjects")
}

model Unit {
  id         String      @id @default(uuid())
  subjectId  String      @map("subject_id")
  subject    Subject     @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  unitNumber Int         @map("unit_number")
  title      String
  notes      ShortNote[]
  questions  Question[]

  @@map("units")
}

model ShortNote {
  id                String            @id @default(uuid())
  unitId            String            @map("unit_id")
  unit              Unit              @relation(fields: [unitId], references: [id], onDelete: Cascade)
  title             String
  contentMarkdown   String            @map("content_markdown")
  orderIndex        Int               @default(0) @map("order_index")
  isHighYield       Boolean           @default(false) @map("is_high_yield")
  curriculumVersion String            @default("NEW_CURRICULUM") @map("curriculum_version")
  isVerified        Boolean           @default(true) @map("is_verified")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  @@map("short_notes")
}

model Question {
  id                String            @id @default(uuid())
  unitId            String            @map("unit_id")
  unit              Unit              @relation(fields: [unitId], references: [id], onDelete: Cascade)
  prompt            String
  options           Json              // Array of { id: "A"|"B"|"C"|"D", text: "..." }
  correctOptionId   String            @map("correct_option_id")
  explanation       String
  difficulty        String            @default("MEDIUM")
  sourceExamYear    Int?              @map("source_exam_year")
  isHighYield       Boolean           @default(false) @map("is_high_yield")
  curriculumVersion String            @default("NEW_CURRICULUM") @map("curriculum_version")
  attempts          QuizAttemptDetail[]

  @@map("questions")
}

// ─── Progress Models ─────────────────────────────────────────────────

model QuizAttempt {
  id             String              @id @default(uuid())
  userId         String              @map("user_id")
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjectId      String              @map("subject_id")
  subject        Subject             @relation(fields: [subjectId], references: [id])
  score          Float
  totalQuestions Int                 @map("total_questions")
  completedAt    DateTime            @default(now()) @map("completed_at")
  details        QuizAttemptDetail[]

  @@map("quiz_attempts")
}

model QuizAttemptDetail {
  id             String      @id @default(uuid())
  attemptId      String      @map("attempt_id")
  attempt        QuizAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId     String      @map("question_id")
  question       Question    @relation(fields: [questionId], references: [id])
  selectedOption String      @map("selected_option")
  isCorrect      Boolean     @map("is_correct")

  @@map("quiz_attempt_details")
}
