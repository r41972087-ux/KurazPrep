  "description": "KurazPrep — Ethiopian ESSLCE Exam Preparation API",
  "type": "module",
  "main": "dist/src/server.js",
  "scripts": {
    "dev": "node --loader ts-node/esm src/server.ts",
    "build": "tsc",
